# Origem privada do backend NestJS, sem /api/v1 nem barra final.
API_ORIGIN=http://localhost:3001
# Origem pública canônica, igual a FRONTEND_URL no backend.
SITE_ORIGIN=http://localhost:3000
# Protótipos editoriais ficam desligados até validação integrada e de segurança.
EDITORIAL_WORKFLOW_ENABLED=false
ENABLE_ADMIN_BFF=false
# Limites da sessão administrativa, em segundos (inatividade e duração máxima).
ADMIN_SESSION_IDLE_SECONDS=7200
ADMIN_SESSION_MAX_SECONDS=43200
# Redis compartilhado e acessível por todas as funções Next (usar TLS/rediss em staging).
# Pode reutilizar o Redis da infraestrutura; nunca apontar staging para produção.
REDIS_URL=redis://127.0.0.1:6379
# Chave exclusiva do BFF: 32 bytes aleatórios em hexadecimal (64 caracteres).
# Igual em todas as funções da mesma implantação; nunca usar NEXT_PUBLIC_.
ADMIN_SESSION_ENCRYPTION_KEY=
